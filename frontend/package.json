{
  "name": "chemistry-uno-frontend",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5000",
    "dev:test": "vite --mode test --port 5000",
    "dev:prod": "vite --mode production --port 5000",
    "build": "tsc && vite build",
    "electron:dev": "cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5000 concurrently -k \"pnpm dev\" \"wait-on http://127.0.0.1:5000 && electron electron/main.cjs\"",
    "electron:run": "pnpm build && electron electron/main.cjs",
    "electron:pack:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && electron-builder --win nsis --x64",
    "android:add": "pnpm cap add android",
    "android:sync": "node scripts/android-sync.cjs",
    "android:open": "pnpm cap open android",
    "android:build:debug": "node scripts/android-build-debug.cjs",
    "android:build:release": "node scripts/android-build-release.cjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@github/webauthn-json": "^2.1.1",
    "axios": "^1.6.5",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "lucide-vue-next": "^0.575.0",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/cropperjs": "^1.3.3",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.6.1",
    "wait-on": "^9.0.5"
  }
}
