VITE_CLARITY_ID=

# Primary server address used by the frontend runtime and Vite dev proxy.
# Example: http://127.0.0.1:8080
VITE_SERVER_ORIGIN=

# Optional shared fallback for Electron / Android packaging scripts.
# Example: http://127.0.0.1:8080 or http://10.0.2.2:8080
CHEM_SERVER_ORIGIN=

# Legacy compatibility variables. Prefer VITE_SERVER_ORIGIN / CHEM_SERVER_ORIGIN.
VITE_API_ORIGIN=
CHEM_ANDROID_API_ORIGIN=
CHEM_CLIENT_API_ORIGIN=
CHEM_ANDROID_KEYSTORE_PATH=
CHEM_ANDROID_KEYSTORE_PASSWORD=
CHEM_ANDROID_KEY_ALIAS=
CHEM_ANDROID_KEY_PASSWORD=
