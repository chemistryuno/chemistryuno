# 应用版本配置
APP_VERSION=1.2.1
APP_VERSION_NAME=Mendeleef

# 数据库类型配置 (sqlite 或 mysql)
# 本地开发推荐使用 sqlite，生产环境推荐使用 mysql
DB_TYPE=sqlite

# SQLite 数据库路径 (当 DB_TYPE=sqlite 时使用)
SQLITE_PATH=./chemistryuno.db

# MySQL 数据库配置 (当 DB_TYPE=mysql 时使用)
MYSQL_DSN=root:password@tcp(localhost:3306)/chemistryuno?charset=utf8mb4&parseTime=True&loc=Local

# JWT密钥配置（生产环境必须修改为至少32个字符的强随机密钥）
JWT_SECRET=change-this-to-a-strong-random-secret-key-at-least-32-chars

# Redis配置（用于缓存和高并发优化）
REDIS_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_AUTO_DISCOVER=false

# WebAuthn配置
WEBAUTHN_RPID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# SMTP配置 (用于邮箱注册验证)
# 如果以下变量均不为空，系统将切换为邮箱注册模式
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WEBAUTHN_ORIGIN=http://localhost:5000
# GitHub OAuth 配置
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# Microsoft OAuth 配置
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:5000/api/auth/ms/callback

# Google OAuth 配置
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Apple OAuth 配置
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=http://localhost:5000/api/auth/apple/callback


# ==========================================
# 性能优化特性开关
# ==========================================

# Redis ZSET 排行榜优化（默认隐式启用，写入不阻塞主流程）
# 查询优化特性，无需手动开启

# 游戏历史查询优化（使用 junction table）
USE_OPTIMIZED_HISTORY_QUERIES=false

# 反应判断 LRU 缓存
ENABLE_REACTION_CACHE=true

# 速率限制器自动清理
RATE_LIMIT_CLEANUP_ENABLED=true
RATE_LIMIT_CLEANUP_INTERVAL_MINUTES=60

# 反作弊批量查询优化
ENABLE_ANTICHEAT_BATCH=false

# 反作弊异步 Streams 队列（启用后游戏结束 API 响应降至 <20ms）
ENABLE_ANTICHEAT_STREAMS=false

# Pub/Sub 跨节点广播（单机部署无需启用）
# 多实例部署时自动激活，无需显式配置

# 慢查询日志阈值（毫秒）
SLOW_QUERY_THRESHOLD_MS=100
SLOW_QUERY_LOG_LEVEL=warn
