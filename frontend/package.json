{
  "name": "chemistry-uno-frontend",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5000",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "copy-dist": "node -e \"const fs=require('fs'),path=require('path');const src='dist',dst='../backend/static/dist';if(fs.existsSync(dst))fs.rmSync(dst,{recursive:true});fs.mkdirSync(path.dirname(dst),{recursive:true});fs.cpSync(src,dst,{recursive:true});console.log('✓ 前端文件已复制到 backend/static/dist')\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@github/webauthn-json": "^2.1.1",
    "axios": "^1.6.5",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.474.0",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
