# MySQL 数据库配置示例
MYSQL_DSN=root:password@tcp(localhost:3306)/chemistryuno?charset=utf8mb4&parseTime=True&loc=Local

# JWT密钥配置（生产环境必须修改为至少32个字符的强随机密钥）
JWT_SECRET=change-this-to-a-strong-random-secret-key-at-least-32-chars

# Redis配置（用于缓存和高并发优化）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# REDIS_DB=0

# WebAuthn配置
WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000