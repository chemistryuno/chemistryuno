# Chemistry UNO V1.0.0 Mendeleef - 环境变量配置
# 复制此文件为 backend/.env 并根据需要修改

# JWT密钥（首次运行会自动生成，生产环境建议手动设置）
# JWT_SECRET=

# ============================================
# Redis配置（可选 - 用于缓存和会话管理）
# ============================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# 数据库配置
# ============================================
# 数据库类型: sqlite 或 mysql
DB_TYPE=sqlite

# SQLite配置
SQLITE_PATH=./chemistryuno.db

# MySQL配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=chemistryuno

# MySQL DSN（自动生成或手动配置）
MYSQL_DSN=root:password@tcp(localhost:3306)/chemistryuno?charset=utf8mb4&parseTime=True&loc=Local
